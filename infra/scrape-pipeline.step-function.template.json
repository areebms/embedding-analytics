{
  "Comment": "Seed a Gutenberg subject, scrape every book it lists, then standardize their headings — one execution takes a subject from a subject id to STANDARDIZED. NOT DEPLOYED: deploy_step_function.sh hardcodes the state machine name to ${LAMBDA_PREFIX}-pipeline, so pointing STEP_FUNCTION_TEMPLATE at this file overwrites the per-book training machine instead of creating a second one. Teach the script a name per template first, or deploy this by hand.",
  "StartAt": "seed-subject",
  "QueryLanguage": "JSONata",
  "States": {
    "seed-subject": {
      "Type": "Task",
      "Comment": "Creates a pipeline entry per book. Returns the subject's whole book list, not just the new rows, so a re-run resumes a partly-scraped subject.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:${LAMBDA_PREFIX}-scrape:$LATEST",
        "Payload": {
          "subject": "{% $states.input.subject %}",
          "stage": "list"
        }
      },
      "Output": {
        "subject": "{% $states.result.Payload.subject %}",
        "found": "{% $states.result.Payload.found %}",
        "created": "{% $states.result.Payload.created %}",
        "indexes": "{% $states.result.Payload.indexes %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "scrape-books"
    },
    "scrape-books": {
      "Type": "Map",
      "Comment": "MaxConcurrency 1: gutenberg.org is a single volunteer-run host, so books go through one at a time, as the scrape.py CLI does.",
      "Items": "{% $states.input.indexes %}",
      "MaxConcurrency": 1,
      "ItemSelector": {
        "index": "{% $states.context.Map.Item.Value %}"
      },
      "Output": {
        "subject": "{% $states.input.subject %}",
        "created": "{% $states.input.created %}",
        "books": "{% $count($states.result) %}",
        "failed": "{% $count($states.result[$exists(error)]) %}"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "scrape-metadata",
        "States": {
          "scrape-metadata": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Arguments": {
              "FunctionName": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:${LAMBDA_PREFIX}-scrape:$LATEST",
              "Payload": {
                "index": "{% $states.input.index %}",
                "stage": "metadata"
              }
            },
            "Output": {
              "index": "{% $states.result.Payload.index %}",
              "status": "{% $states.result.Payload.status %}"
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "book-failed",
                "Output": {
                  "index": "{% $states.input.index %}",
                  "error": "{% $states.errorOutput.Error %}"
                }
              }
            ],
            "Next": "ready-for-content?"
          },
          "ready-for-content?": {
            "Type": "Choice",
            "Comment": "SCRAPED_METADATA is scrape_book_content's own precondition. Gating on it positively also short-circuits books an earlier run already took to SCRAPED_HTML, so a resume does not pay the wait and a no-op invocation per finished book.",
            "Choices": [
              {
                "Condition": "{% $states.input.status = 'SCRAPED_METADATA' %}",
                "Next": "wait-before-content"
              }
            ],
            "Default": "book-done"
          },
          "wait-before-content": {
            "Type": "Wait",
            "Seconds": 3,
            "Next": "scrape-content"
          },
          "scrape-content": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Arguments": {
              "FunctionName": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:${LAMBDA_PREFIX}-scrape:$LATEST",
              "Payload": {
                "index": "{% $states.input.index %}",
                "stage": "content"
              }
            },
            "Output": {
              "index": "{% $states.result.Payload.index %}",
              "status": "{% $states.result.Payload.status %}"
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "book-failed",
                "Output": {
                  "index": "{% $states.input.index %}",
                  "error": "{% $states.errorOutput.Error %}"
                }
              }
            ],
            "End": true
          },
          "book-done": {
            "Type": "Succeed"
          },
          "book-failed": {
            "Type": "Succeed",
            "Comment": "One book failing must not discard the rest of the subject, which is what an uncaught error in an inline Map would do. The book keeps its pipeline_status, so the next run retries it; the error rides out in the Map result and is counted in `failed`."
          }
        }
      },
      "Next": "standardize-submit"
    },
    "standardize-submit": {
      "Type": "Task",
      "Comment": "Opens one Anthropic batch over every book at SCRAPED_HTML and returns without waiting. The sweep is corpus-wide, not scoped to this subject, so two overlapping executions of this machine collide: the second one's submit finds the first's books at STANDARDIZE_SUBMITTED and returns book_count 0. Run subjects one at a time.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:${LAMBDA_PREFIX}-standardize-headings:$LATEST",
        "Payload": {
          "stage": "submit"
        }
      },
      "Output": {
        "subject": "{% $states.input.subject %}",
        "books": "{% $states.input.books %}",
        "failed": "{% $states.input.failed %}",
        "batch_id": "{% $states.result.Payload.batch_id %}",
        "book_count": "{% $states.result.Payload.book_count %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "anything-submitted?"
    },
    "anything-submitted?": {
      "Type": "Choice",
      "Comment": "book_count 0 has two causes and neither is an error: nothing sat at SCRAPED_HTML, or a batch is already in flight. Gating on the count rather than on batch_id keeps the condition off a JSON null.",
      "Choices": [
        {
          "Condition": "{% $states.input.book_count = 0 %}",
          "Next": "nothing-to-standardize"
        }
      ],
      "Default": "wait-for-batch"
    },
    "nothing-to-standardize": {
      "Type": "Succeed"
    },
    "wait-for-batch": {
      "Type": "Wait",
      "Comment": "The batch is asynchronous, so the waiting belongs here rather than inside a Lambda holding an open invocation. Each collect rebuilds its state from the batch id, so a poll that lands on a cold container is correct; 300s caps the lag after the batch ends without burning invocations on a batch that may run for hours.",
      "Seconds": 300,
      "Next": "standardize-collect"
    },
    "standardize-collect": {
      "Type": "Task",
      "Comment": "Returns immediately while the batch is still running, and settles it once it has ended.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:${LAMBDA_PREFIX}-standardize-headings:$LATEST",
        "Payload": {
          "stage": "collect",
          "batch_id": "{% $states.input.batch_id %}"
        }
      },
      "Output": {
        "subject": "{% $states.input.subject %}",
        "books": "{% $states.input.books %}",
        "failed": "{% $states.input.failed %}",
        "batch_id": "{% $states.input.batch_id %}",
        "batch_status": "{% $states.result.Payload.batch_status %}",
        "standardized": "{% $states.result.Payload.standardized %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "batch-ended?"
    },
    "batch-ended?": {
      "Type": "Choice",
      "Comment": "Written as the negative so an unfamiliar processing_status keeps polling instead of reporting the subject done. 'ended' covers expiry too, so the loop always terminates.",
      "Choices": [
        {
          "Condition": "{% $states.input.batch_status != 'ended' %}",
          "Next": "wait-for-batch"
        }
      ],
      "Default": "subject-done"
    },
    "subject-done": {
      "Type": "Succeed"
    }
  }
}
